---
import FadeIn from "../ui/FadeIn.astro";
---

<section class="relative min-h-screen flex items-center overflow-hidden">

  <!-- Background -->
  
  <div class="absolute inset-0 bg-gradient-to-b from-black via-zinc-950 to-black"></div>
  <video
  autoplay
  muted
  loop
  playsinline
  class="absolute inset-0 w-full h-full object-cover opacity-20"
>
  <source src="/videos/video.mp4" type="video/mp4" />
</video>

  <!-- Grid -->
  <div class="absolute inset-0 opacity-[0.04]">
    <div class="h-full w-full bg-[linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] bg-[size:80px_80px]"></div>
  </div>

  <!-- Glow -->
  <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/30"></div>
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-red-700/10 rounded-full blur-3xl"></div>

  <!-- Content -->
 
  <div class="container-custom relative z-10">
    <FadeIn>
      <div class="max-w-5xl">

        <p class="uppercase tracking-[0.4em] text-xs text-zinc-500 mb-8">
          Paranoyz Music
        </p>

        <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-bold leading-[0.95] tracking-tight mb-8">
          Producción musical y audiovisual con visión moderna.
        </h1>

        <p class="text-zinc-400 text-lg md:text-xl leading-relaxed max-w-2xl mb-12">
          Estudio de grabación y productora especializada en proyectos musicales, audiovisuales y desarrollo artístico profesional.
        </p>

        <div class="flex flex-wrap gap-4">

          <a
            href="#"
            class="bg-white text-black px-8 py-4 rounded-full font-medium transition duration-300 ease-out hover:scale-105"
          >
            Ver trabajos
          </a>

          <a
            href="#"
            class="border border-white/10 bg-white/5 backdrop-blur-sm px-8 py-4 rounded-full transition duration-300 ease-out hover:bg-white/10"
          >
            Contactar
          </a>
      </div>
    </FadeIn>
    </div>
  </div>

</section>