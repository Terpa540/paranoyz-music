---
import FadeIn from "../ui/FadeIn.astro";
---

<section class="relative min-h-screen flex items-start md:items-center overflow-hidden">

  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-b from-black via-zinc-950 to-black"></div>

  <video
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover opacity-20"
  >
    <source src="/videos/video.mp4" type="video/mp4" />
  </video>

  <!-- Grid -->
  <div class="absolute inset-0 opacity-[0.04]">
    <div class="h-full w-full bg-[linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] bg-[size:80px_80px]"></div>
  </div>

  <!-- Overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/30"></div>

  <!-- Glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-red-700/10 rounded-full blur-3xl"></div>

  <!-- Content -->
  <div class="container-custom relative z-10 pt-28 md:pt-0">

    <FadeIn>

      <div class="max-w-4xl">

        <p class="uppercase tracking-[0.4em] text-xs text-zinc-500 mb-8">
          Paranoyz Music
        </p>

        <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-[0.95] tracking-tight mb-8">
          Producción musical profesional en Valencia.
        </h1>

        <p class="text-zinc-400 text-lg md:text-xl leading-relaxed max-w-3xl mb-12">
          Grabación, mezcla, mastering, desarrollo artístico e instalaciones profesionales para artistas, bandas y productores.
        </p>

        <!-- Botones -->
        <div class="flex flex-wrap gap-4">

          <a
            href="/instalaciones"
            class="bg-white text-black px-8 py-4 rounded-full font-medium transition duration-300 ease-out hover:scale-105"
          >
            Ver instalaciones
          </a>

          <a
            href="/contacto"
            class="border border-white/10 bg-white/5 backdrop-blur-sm px-8 py-4 rounded-full transition duration-300 ease-out hover:bg-white/10"
          >
            Solicitar información
          </a>

        </div>

        <!-- Indicadores -->
        <div class="mt-16 pt-10 border-t border-white/10 grid grid-cols-2 md:grid-cols-4 gap-6">

          <div>
            <p class="text-white font-semibold">
              Grabación
            </p>
            <p class="text-zinc-500 text-sm">
              Vocalistas y bandas
            </p>
          </div>

          <div>
            <p class="text-white font-semibold">
              Producción
            </p>
            <p class="text-zinc-500 text-sm">
              Asesoría y desarrollo
            </p>
          </div>

          <div>
            <p class="text-white font-semibold">
              Espacios
            </p>
            <p class="text-zinc-500 text-sm">
              Alquiler profesional
            </p>
          </div>

          <div>
            <p class="text-white font-semibold">
              Audiovisual
            </p>
            <p class="text-zinc-500 text-sm">
              Producción visual
            </p>
          </div>

        </div>

      </div>

    </FadeIn>

  </div>

</section>