---
import { Image } from "astro:assets";

import studio1 from "../../assets/showcase/studio-1.jpg";
import studio2 from "../../assets/showcase/studio-2.jpg";
import studio3 from "../../assets/showcase/studio-3.jpg";
---

<section class="py-24 md:py-32 relative overflow-hidden section-line">

  <div class="container-custom">

    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10 mb-20">

      <div>

        <p class="uppercase tracking-[0.3em] text-xs text-zinc-500 mb-4">
          Trabajos
        </p>

        <h2 class="text-4xl md:text-6xl font-bold leading-tight max-w-3xl">
          Proyectos desarrollados desde una visión técnica y artística.
        </h2>

      </div>

      <p class="text-zinc-400 max-w-md leading-relaxed">
        Producciones musicales y audiovisuales enfocadas en identidad, calidad y proyección profesional.
      </p>

    </div>

    <!-- Grid -->

    <div class="grid lg:grid-cols-2 gap-6">

      <!-- Item -->

      <div class="group relative overflow-hidden rounded-3xl bg-zinc-900 aspect-[4/5]">

        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent z-10"></div>
        <div class="absolute inset-0 bg-red-700/0 group-hover:bg-red-700/10 transition duration-700"></div>

        <Image
              src={studio1}
              alt="Producción musical"
              class="w-full h-full object-cover transition duration-700 group-hover:scale-[1.03] group-hover:brightness-110"
              format="webp"
              quality={90}
            />

        <div class="absolute bottom-0 left-0 z-20 p-8">

          <p class="uppercase tracking-[0.3em] text-xs text-zinc-400 mb-3">
            Producción Musical
          </p>

          <h3 class="text-3xl font-bold">
            Desarrollo Artístico
          </h3>

        </div>

      </div>

      <!-- Column -->

      <div class="flex flex-col gap-6">

        <!-- Item -->

        <div class="group relative overflow-hidden rounded-3xl bg-zinc-900 aspect-[4/3]">

          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-red-700/0 group-hover:bg-red-700/10 transition duration-700"></div>

          <Image
                src={studio2}
                alt="Producción musical"
                class="w-full h-full object-cover transition duration-700 group-hover:scale-105"
                format="webp"
                quality={90}
              />

          <div class="absolute bottom-0 left-0 z-20 p-8">

            <p class="uppercase tracking-[0.3em] text-xs text-zinc-400 mb-3">
              Grabación
            </p>

            <h3 class="text-3xl font-bold">
              Sesiones Profesionales
            </h3>

          </div>

        </div>

        <!-- Item -->

        <div class="group relative overflow-hidden rounded-3xl bg-zinc-900 aspect-[4/3]">

          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-red-700/0 group-hover:bg-red-700/10 transition duration-700"></div>

          <Image
                src={studio3}
                alt="Producción musical"
                class="w-full h-full object-cover transition duration-700 group-hover:scale-105"
                format="webp"
                quality={90}
              />

          <div class="absolute bottom-0 left-0 z-20 p-8">

            <p class="uppercase tracking-[0.3em] text-xs text-zinc-400 mb-3">
              Audiovisual
            </p>

            <h3 class="text-3xl font-bold">
              Contenido Visual
            </h3>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>