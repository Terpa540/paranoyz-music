---
import FadeIn from "../ui/FadeIn.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="py-24 md:py-32 relative section-line">

  <div class="container-custom">

    <FadeIn>
      <SectionHeading
        label="Por qué Paranoyz"
        title="Más que un estudio de grabación."
        description="Combinamos instalaciones profesionales, experiencia musical y acompañamiento técnico para ayudar a cada proyecto a alcanzar su máximo potencial."
      />
    </FadeIn>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">

      <div class="border border-white/10 rounded-2xl p-8">
        <h3 class="font-bold text-xl mb-4">
          Producción Integral
        </h3>
        <p class="text-zinc-400">
          Acompañamos cada proyecto desde la idea inicial hasta la entrega final.
        </p>
      </div>

      <div class="border border-white/10 rounded-2xl p-8">
        <h3 class="font-bold text-xl mb-4">
          Instalaciones Profesionales
        </h3>
        <p class="text-zinc-400">
          Espacios preparados para artistas, bandas, productores y equipos creativos.
        </p>
      </div>

      <div class="border border-white/10 rounded-2xl p-8">
        <h3 class="font-bold text-xl mb-4">
          Flexibilidad
        </h3>
        <p class="text-zinc-400">
          Grabación, producción, alquiler de instalaciones o servicios a medida.
        </p>
      </div>

      <div class="border border-white/10 rounded-2xl p-8">
        <h3 class="font-bold text-xl mb-4">
          Visión Artística y Técnica
        </h3>
        <p class="text-zinc-400">
          Entendemos tanto la parte creativa como la profesional de cada producción.
        </p>
      </div>

    </div>

  </div>

</section>