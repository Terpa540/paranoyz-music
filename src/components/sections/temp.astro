---
import SectionHeading from "../ui/SectionHeading.astro";
import FadeIn from "../ui/FadeIn.astro";
---

<section class="py-24 md:py-32 relative section-line">

  <div class="container-custom">
  <FadeIn delay={200}>
    <SectionHeading
      label="Servicios"
      title="Soluciones audiovisuales y musicales enfocadas en calidad."
      description="Producción musical, grabación y desarrollo audiovisual con enfoque técnico y artístico profesional."
    />
  </FadeIn>
    <div class="grid lg:grid-cols-12 gap-px bg-white/10 border border-white/10">

      <div class="lg:col-span-7 bg-zinc-950 p-10">
        <h3 class="text-2xl font-bold mb-4">
          Producción Musical
        </h3>

        <p class="text-zinc-400 leading-relaxed">
          Desarrollo artístico, composición, arreglos y producción profesional adaptada a cada proyecto.
        </p>
      </div>

      <div class="lg:col-span-5 bg-zinc-950 p-10">
        <h3 class="text-2xl font-bold mb-4">
          Grabación
        </h3>

        <p class="text-zinc-400 leading-relaxed">
          Espacios y equipamiento profesional para sesiones de grabación vocal e instrumental.
        </p>
      </div>

      <div class="lg:col-span-5 bg-zinc-950 p-10">
        <h3 class="text-2xl font-bold mb-4">
          Mezcla & Mastering
        </h3>

        <p class="text-zinc-400 leading-relaxed">
          Procesado técnico y artístico orientado a lograr producciones competitivas y profesionales.
        </p>
      </div>

      <div class="lg:col-span-7 bg-zinc-950 p-10">
        <h3 class="text-2xl font-bold mb-4">
          Producción Audiovisual
        </h3>

        <p class="text-zinc-400 leading-relaxed">
          Desarrollo visual y contenido audiovisual alineado con la identidad artística del proyecto.
        </p>
      </div>

    </div>

  </div>

</section>