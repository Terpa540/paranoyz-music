---
interface Props {
  label: string;
  title: string;
  description?: string;
}

const { label, title, description } = Astro.props;
---

<div class="max-w-4xl mb-20">

  <p class="uppercase tracking-[0.35em] text-xs text-zinc-500 mb-5">
    {label}
  </p>

  <h2 class="text-4xl md:text-6xl font-bold leading-[1.05] tracking-tight mb-6">
    {title}
  </h2>

  {
    description && (
      <p class="text-zinc-400 text-lg leading-relaxed max-w-2xl">
        {description}
      </p>
    )
  }

</div>