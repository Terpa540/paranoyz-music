---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contacto | Paranoyz Music Valencia"
  description="Contacta con Paranoyz Music para producción musical, grabación profesional, alquiler de instalaciones, mezcla, mastering y proyectos audiovisuales."
>

  <section class="py-32">

    <div class="container-custom">

      <!-- Hero -->

      <div class="max-w-4xl mb-20">

        <p class="uppercase tracking-[0.3em] text-xs text-zinc-500 mb-6">
          Contacto
        </p>

        <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-8">
          Hablemos de tu próximo proyecto.
        </h1>

        <p class="text-zinc-400 text-lg md:text-xl max-w-3xl leading-relaxed">
          Contacta con nuestro estudio de grabación y producción musical en Valencia para desarrollar proyectos de grabación, mezcla, mastering, alquiler de instalaciones y producción audiovisual.
        </p>

      </div>

      <!-- Servicios de contacto -->

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-24">

        <div class="border border-white/10 rounded-2xl p-8">
          <h3 class="font-bold text-xl mb-4">
            Producción Musical
          </h3>

          <p class="text-zinc-400">
            Desarrollo creativo y técnico de proyectos musicales.
          </p>
        </div>

        <div class="border border-white/10 rounded-2xl p-8">
          <h3 class="font-bold text-xl mb-4">
            Grabación
          </h3>

          <p class="text-zinc-400">
            Sesiones para vocalistas, músicos y bandas.
          </p>
        </div>

        <div class="border border-white/10 rounded-2xl p-8">
          <h3 class="font-bold text-xl mb-4">
            Alquiler de Espacios
          </h3>

          <p class="text-zinc-400">
            Instalaciones disponibles con o sin técnico.
          </p>
        </div>

        <div class="border border-white/10 rounded-2xl p-8">
          <h3 class="font-bold text-xl mb-4">
            Audiovisual
          </h3>

          <p class="text-zinc-400">
            Producción visual mediante colaboradores especializados.
          </p>
        </div>

      </div>

      <!-- Formulario -->

      <div class="grid lg:grid-cols-2 gap-12">

        <div>

          <h2 class="text-3xl font-bold mb-6">
            Cuéntanos qué necesitas.
          </h2>

          <p class="text-zinc-400 leading-relaxed">
            Cuéntanos tu idea, objetivos o necesidades técnicas. Analizaremos el proyecto y te propondremos la solución más adecuada para su desarrollo.
          </p>
        <div class="mt-10 space-y-4 text-zinc-400">

        <div>
          <p class="text-white font-medium mb-1">
            Correo electrónico
          </p>
          <p>
            info@paranoyz.com
          </p>
        </div>

        <div>
          <p class="text-white font-medium mb-1">
            Ubicación
          </p>
          <p>
            Valencia · Comunidad Valenciana · España
          </p>
        </div>

        <div>
          <p class="text-white font-medium mb-1">
            Atención personalizada
          </p>
          <p>
            Analizamos cada proyecto de forma individual para ofrecer la solución técnica, creativa y presupuestaria más adecuada a cada artista, banda o productor.
          </p>
        </div>

      </div>
        </div>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-6"
        >

          <input
            type="hidden"
            name="access_key"
            value={import.meta.env.PUBLIC_WEB3FORMS_KEY}
          />

          <input
            type="hidden"
            name="subject"
            value="Nueva solicitud desde Paranoyz Music"
          />

          <input
            type="text"
            name="nombre"
            placeholder="Nombre"
            required
            class="w-full bg-zinc-900 border border-white/10 rounded-xl px-5 py-4 outline-none focus:border-white/30"
          />

          <input
            type="email"
            name="email"
            placeholder="Email"
            required
            class="w-full bg-zinc-900 border border-white/10 rounded-xl px-5 py-4 outline-none focus:border-white/30"
          />

         <select
              name="servicio"
              required
              class="w-full bg-zinc-900 border border-white/10 rounded-xl px-5 py-4 outline-none focus:border-white/30"
            >
              <option selected disabled>
                Selecciona un servicio
              </option>
              <option>Producción Musical</option>
              <option>Grabación</option>
              <option>Mezcla & Mastering</option>
              <option>Alquiler de Espacios</option>
              <option>Audiovisual</option>
              <option>Otros</option>
            </select>

            <input
              type="text"
              name="fecha"
              placeholder="¿Cuándo te gustaría comenzar el proyecto?"
              class="w-full bg-zinc-900 border border-white/10 rounded-xl px-5 py-4 outline-none focus:border-white/30"
            />

          <textarea
            name="proyecto"
            rows="6"
            required
            placeholder="Explícanos tu proyecto, necesidades, número de canciones, tipo de producción o cualquier información que consideres relevante."
            class="w-full bg-zinc-900 border border-white/10 rounded-xl px-5 py-4 outline-none focus:border-white/30"
          ></textarea>

          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
          />

          <button
            type="submit"
            class="bg-white text-black px-8 py-4 rounded-full font-medium transition hover:scale-105"
          >
            Solicitar información
          </button>

        </form>
        <div class="mt-16 mb-16">

          <h2 class="text-3xl font-bold mb-6">
            Trabajamos con artistas y proyectos de toda España.
          </h2>

          <p class="text-zinc-400 leading-relaxed max-w-4xl">
            Aunque nuestras instalaciones están ubicadas en Valencia, trabajamos con artistas, bandas, productores y proyectos audiovisuales procedentes de toda España. Cada producción se estudia de forma personalizada para adaptar recursos, tiempos y necesidades técnicas a cada proyecto.
          </p>

        </div>

        <div class="mt-20 border-t border-white/10 pt-12">

  <h2 class="text-3xl font-bold mb-8">
    Cómo trabajamos
  </h2>

  <div class="grid md:grid-cols-4 gap-8">

    <div>
      <p class="text-white font-semibold mb-3">
        01
      </p>
      <p class="text-zinc-400">
        Recibimos tu solicitud.
      </p>
    </div>

    <div>
      <p class="text-white font-semibold mb-3">
        02
      </p>
      <p class="text-zinc-400">
        Analizamos las necesidades del proyecto.
      </p>
    </div>

    <div>
      <p class="text-white font-semibold mb-3">
        03
      </p>
      <p class="text-zinc-400">
        Proponemos la mejor solución técnica y artística.
      </p>
    </div>

    <div>
      <p class="text-white font-semibold mb-3">
        04
      </p>
      <p class="text-zinc-400">
        Definimos calendario y presupuesto.
      </p>
    </div>

  </div>

</div>

      </div>

    </div>

  </section>

</MainLayout>