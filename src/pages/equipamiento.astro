---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Equipamiento Profesional | Paranoyz Music Valencia"
  description="Hardware analógico, microfonía profesional, sistemas de grabación y equipamiento técnico disponible en Paranoyz Music."
>

<section class="py-32">

  <div class="container-custom">

    <!-- Hero -->

    <div class="max-w-5xl mb-24">

      <p class="uppercase tracking-[0.3em] text-xs text-zinc-500 mb-6">
        Equipamiento
      </p>

      <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-8">
        Equipamiento profesional para producciones musicales de alto nivel.
      </h1>

      <p class="text-zinc-400 text-lg md:text-xl max-w-4xl leading-relaxed">
        Paranoyz Music dispone de hardware analógico, sistemas de grabación, microfonía profesional y herramientas de producción seleccionadas para afrontar proyectos musicales, audiovisuales y grabaciones de cualquier dimensión.
      </p>

    </div>

        <!-- Hardware -->

    <div class="mb-24">

      <h2 class="text-4xl font-bold mb-10">
        Hardware y Outboard
      </h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

        <div class="border border-white/10 rounded-2xl p-8">
          <h3 class="font-bold mb-4">
            Previos y Channel Strips
          </h3>

          <ul class="space-y-2 text-zinc-400">
            <li>Avalon VT-737SP</li>
            <li>Universal Audio LA-610 MkII</li>
            <li>Neve 1073LB (x2)</li>
            <li>Millennia HV-35 (x2)</li>
            <li>AEA RPQ500</li>
            <li>Audient ASP008</li>
          </ul>
        </div>

        <div class="border border-white/10 rounded-2xl p-8">
          <h3 class="font-bold mb-4">
            Procesamiento
          </h3>

          <ul class="space-y-2 text-zinc-400">
            <li>Kush Clariphonic</li>
            <li>SPL Vitalizer Mk2</li>
            <li>IGS Buss Compressor</li>
            <li>TC Electronic M4000</li>
            <li>Elysia Skulpter 500</li>
          </ul>
        </div>

        <div class="border border-white/10 rounded-2xl p-8">
          <h3 class="font-bold mb-4">
            Conversión y Routing
          </h3>

          <ul class="space-y-2 text-zinc-400">
            <li>Motu 112D</li>
            <li>Apogee Rosetta 800 (x2)</li>
            <li>Patchbay TTI 48</li>
            <li>API 500-8P Lunchbox</li>
            <li>Audient Sumo 16</li>
          </ul>
        </div>

      </div>

    </div>

        <!-- Microfonía -->

    <div class="mb-24">

      <h2 class="text-4xl font-bold mb-10">
        Microfonía Profesional
      </h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">

        <div class="border border-white/10 rounded-2xl p-8">
          <h3 class="font-bold mb-4">
            Neumann
          </h3>

          <ul class="space-y-2 text-zinc-400">
            <li>U87Ai (x2)</li>
            <li>TLM 103</li>
            <li>TLM 193</li>
            <li>KM184</li>
          </ul>
        </div>

        <div class="border border-white/10 rounded-2xl p-8">
          <h3 class="font-bold mb-4">
            Condensador
          </h3>

          <ul class="space-y-2 text-zinc-400">
            <li>Lewitt LCT 840</li>
            <li>Lewitt LCT 441 Pair</li>
            <li>AKG C414 (x2)</li>
            <li>AT5045P (x2)</li>
          </ul>
        </div>

        <div class="border border-white/10 rounded-2xl p-8">
          <h3 class="font-bold mb-4">
            Dinámicos
          </h3>

          <ul class="space-y-2 text-zinc-400">
            <li>Sennheiser MD421 (x4)</li>
            <li>Electro Voice RE20 (x2)</li>
            <li>Shure Beta Series</li>
            <li>Shure SM57</li>
          </ul>
        </div>

        <div class="border border-white/10 rounded-2xl p-8">
          <h3 class="font-bold mb-4">
            Ribbon y Especializados
          </h3>

          <ul class="space-y-2 text-zinc-400">
            <li>AEA R84 Ribbon</li>
            <li>Sennheiser Shotgun</li>
            <li>Oktava MK012</li>
            <li>Oktava MK1019</li>
          </ul>
        </div>

      </div>

    </div>

        <!-- Grandes Producciones -->

    <div class="border border-white/10 rounded-[40px] p-12 md:p-16 mb-24">

      <h2 class="text-4xl font-bold mb-8">
        Preparado para grabaciones de gran formato.
      </h2>

      <p class="text-zinc-400 text-lg leading-relaxed max-w-4xl mb-10">
        El estudio dispone de infraestructura preparada para grabaciones complejas, sesiones con bandas completas, producciones externas y proyectos que requieren múltiples canales simultáneos de grabación.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">

        <div class="border border-white/10 rounded-2xl p-6">
          33 micrófonos disponibles
        </div>

        <div class="border border-white/10 rounded-2xl p-6">
          Sistema personal monitoring
        </div>

        <div class="border border-white/10 rounded-2xl p-6">
          DI Boxes Radial y Proel
        </div>

        <div class="border border-white/10 rounded-2xl p-6">
          Cableado y soporte completo
        </div>

      </div>

    </div>

        <div class="text-center">

      <h2 class="text-4xl font-bold mb-6">
        ¿Necesitas información técnica?
      </h2>

      <p class="text-zinc-400 max-w-2xl mx-auto mb-10">
        Contacta con nosotros para conocer disponibilidad, configuración técnica y necesidades específicas de tu proyecto.
      </p>

      <a
        href="/contacto"
        class="inline-flex bg-white text-black px-8 py-4 rounded-full font-medium transition hover:scale-105"
      >
        Solicitar información
      </a>

    </div>

  </div>

</section>

</MainLayout>