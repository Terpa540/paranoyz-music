---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {

  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: {
      slug: project.slug,
    },

    props: {
      project,
    },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<MainLayout
  title={`${project.data.title} | Paranoyz Music`}
  description={project.data.description}
>

<section class="py-32">

  <div class="container-custom max-w-5xl">

    <p class="uppercase tracking-[0.3em] text-xs text-zinc-500 mb-5">
      {project.data.category}
    </p>

    <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-8">
      {project.data.title}
    </h1>

    <p class="text-zinc-400 text-xl mb-16">
      {project.data.description}
    </p>
    <div class="flex flex-wrap gap-10 text-sm text-zinc-500 mb-16">

      <div>
        <p class="text-zinc-400 mb-1">Cliente</p>
        <p>{project.data.client}</p>
      </div>

      <div>
        <p class="text-zinc-400 mb-1">Año</p>
        <p>{project.data.year}</p>
      </div>

    </div>
    <div class="aspect-video rounded-3xl overflow-hidden bg-zinc-900 mb-20">

      <img
        src={project.data.cover}
        alt={project.data.title}
        class="w-full h-full object-cover"
      />

    </div>

    <article class="prose prose-invert max-w-none">
      <Content />
    </article>

  </div>

</section>

</MainLayout>