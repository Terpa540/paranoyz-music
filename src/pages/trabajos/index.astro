---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<MainLayout
  title="Trabajos | Paranoyz Music"
  description="Portfolio audiovisual y musical."
>

<section class="py-32">

  <div class="container-custom">

    <div class="max-w-5xl mb-24">

  <p class="uppercase tracking-[0.3em] text-xs text-zinc-500 mb-6">
    Portfolio
  </p>

  <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-8">
    Proyectos musicales y audiovisuales desarrollados desde Paranoyz Music.
  </h1>

  <p class="text-zinc-400 text-lg md:text-xl max-w-3xl leading-relaxed">
    Producción musical, grabación, mezcla, mastering y proyectos audiovisuales desarrollados junto a artistas, bandas y profesionales del sector.
  </p>

</div>

    <div class="grid md:grid-cols-2 gap-10">

      {
        projects.map((project) => (

          <a
            href={`/trabajos/${project.slug}`}
            class="group block"
          >

            <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-zinc-900 mb-6">

              <img
                src={project.data.cover}
                alt={project.data.title}
                class="w-full h-full object-cover transition duration-700 group-hover:scale-105"
              />

            </div>

            <p class="uppercase tracking-[0.3em] text-xs text-zinc-500 mb-3">
              {project.data.category}
            </p>

            <h2 class="text-2xl md:text-3xl font-bold mb-3">
              {project.data.title}
            </h2>

            <p class="text-zinc-400">
              {project.data.description}
            </p>

          </a>

        ))
      }

    </div>

  </div>
  <div class="border-t border-white/10 mt-24 pt-16 text-center">

  <h2 class="text-4xl font-bold mb-6">
    ¿Quieres desarrollar tu próximo proyecto con nosotros?
  </h2>

  <p class="text-zinc-400 max-w-2xl mx-auto mb-8">
    Estaremos encantados de ayudarte tanto en producción musical como en grabación, mezcla, mastering o alquiler de instalaciones.
  </p>

  <a
    href="/contacto"
    class="inline-flex bg-white text-black px-8 py-4 rounded-full font-medium transition hover:scale-105"
  >
    Solicitar información
  </a>

</div>

</section>

</MainLayout>